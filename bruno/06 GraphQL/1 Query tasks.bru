meta {
  name: 1 Query tasks
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query Tasks($priority: Priority) {
    tasks(priority: $priority) {
      id
      title
      priority
      done
    }
  }
}

body:graphql:vars {
  {"priority": "high"}
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
