meta {
  name: 3 Create task
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:graphql {
  mutation CreateTask($title: String!, $priority: Priority) {
    createTask(title: $title, priority: $priority) {
      id
      title
      priority
    }
  }
}

body:graphql:vars {
  {
    "title": "Created with GraphQL",
    "priority": "high"
  }
}

script:post-response {
  bru.setVar("gqlTaskId", res.body.data.createTask.id);
}

tests {
  test("task created", function () {
    expect(res.body.errors).to.equal(undefined);
    expect(res.body.data.createTask.title).to.equal("Created with GraphQL");
  });
}
