meta {
  name: Update Task (PUT)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/tasks/{{taskId}}
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Record and edit Bruno episode 1",
    "priority": "medium",
    "done": false
  }
}

tests {
  test("full update works", function () {
    expect(res.status).to.equal(200);
    expect(res.body.title).to.equal("Record and edit Bruno episode 1");
    expect(res.body.priority).to.equal("medium");
  });
}
