meta {
  name: Mark Done (PATCH)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/tasks/{{taskId}}
  body: json
  auth: inherit
}

body:json {
  {
    "done": true
  }
}

tests {
  test("only 'done' changes", function () {
    expect(res.status).to.equal(200);
    expect(res.body.done).to.equal(true);
    expect(res.body.title).to.equal("Record and edit Bruno episode 1");
  });
}
