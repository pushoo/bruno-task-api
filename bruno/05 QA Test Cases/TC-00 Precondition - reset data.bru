assert {
  res.status: eq 200
  res.body.tasks.length: eq 3
}

docs {
  **Test case:** TC-00 (precondition for every test in this folder)
  **Purpose:** Start every run from the same 3 starter tasks, so results repeat.
  **Expected:** 200, and exactly 3 tasks.
}
