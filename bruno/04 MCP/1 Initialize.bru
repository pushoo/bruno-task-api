meta {
  name: 1 Initialize
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2025-06-18",
      "capabilities": {},
      "clientInfo": { "name": "bruno", "version": "3" }
    }
  }
}

tests {
  test("server introduces itself", function () {
    expect(res.status).to.equal(200);
    expect(res.body.result.serverInfo.name).to.equal("task-api-mcp");
    expect(res.body.result.capabilities).to.have.property("tools");
  });
}
