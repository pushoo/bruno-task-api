meta {
  name: Invalid Body
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: inherit
}

body:json {
  {
    "title": "x",
    "priority": "urgent"
  }
}

tests {
  test("returns 400 with both validation errors", function () {
    expect(res.status).to.equal(400);
    expect(res.body.errors).to.have.lengthOf(2);
  });
}
