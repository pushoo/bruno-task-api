meta {
  name: TC-03 Login with wrong password returns 401
  type: http
  seq: 4
  tags: [
    regression
    negative
  ]
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "wrong"
  }
}

assert {
  res.status: eq 401
  res.body.error: eq Invalid username or password
}

tests {
  test("no token is leaked on failure", function () {
    expect(res.body).to.not.have.property("token");
  });
}

docs {
  **Test case:** TC-03  |  **Requirement:** REQ-02
  **Steps:** POST /api/auth/login with password "wrong".
  **Expected:** 401, error "Invalid username or password", and no token in the body.
}
