meta {
  name: Create Task (token from login)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Token from login task",
    "priority": "high"
  }
}

script:post-response {
  bru.setVar("taskId", res.body.id);
}

tests {
  test("task is created", function () {
    expect(res.status).to.equal(201);
  });
}
