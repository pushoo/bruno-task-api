meta {
  name: SEC-04 PATCH cannot change the id
  type: http
  seq: 5
  tags: [
    security
  ]
}

patch {
  url: {{baseUrl}}/api/tasks/{{secTaskId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "id": "hijacked",
    "done": true
  }
}

tests {
  test("id did not change", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("secTaskId"));
  });
}

docs {
  **OWASP API3: mass assignment on update**
  **Expected:** 200, and the id stays the same.
}
